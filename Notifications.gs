function sendCustomer_(b,subject,message){if(b['Email'])try{MailApp.sendEmail({to:String(b['Email']),subject:'['+APP.NAME+'] '+subject,body:message+'\n訂單：'+b['訂單編號']+'\n聯絡電話：'+APP.CONTACT.phone+'\n官方LINE：'+APP.CONTACT.lineUrl});log_('system','Email寄送成功',b['訂單編號'],subject)}catch(e){log_('system','Email寄送失敗',b['訂單編號'],String(e))}if(b['LINE User ID'])linePush_(b['LINE User ID'],subject+'\n'+message+'\n訂單：'+b['訂單編號'])}
function notifyAdmin_(title,b){let email=setting_('管理員通知Email','');if(email)try{MailApp.sendEmail(email,'['+APP.NAME+'] '+title,'訂單：'+b['訂單編號']+'\n旅客：'+b['姓名']+'\n金額：'+b['總金額'])}catch(e){log_('system','管理員Email失敗',b['訂單編號'],String(e))}let uid=PropertiesService.getScriptProperties().getProperty('ADMIN_LINE_USER_ID');if(uid)linePush_(uid,title+' '+b['訂單編號']+' '+b['姓名'])}
function linePush_(uid,msg){let token=PropertiesService.getScriptProperties().getProperty('LINE_CHANNEL_ACCESS_TOKEN');if(!token)return;let r=UrlFetchApp.fetch('https://api.line.me/v2/bot/message/push',{method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+token},payload:JSON.stringify({to:uid,messages:[{type:'text',text:String(msg).slice(0,4900)}]}),muteHttpExceptions:true});if(r.getResponseCode()>=300)log_('system','LINE推播失敗','',r.getContentText())}
