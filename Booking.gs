function day_(x){let d=new Date(x);if(isNaN(d))throw Error('日期格式錯誤');return new Date(d.getFullYear(),d.getMonth(),d.getDate())}function nights_(a,b){return Math.round((day_(b)-day_(a))/86400000)}function overlap_(a,b,c,d){return day_(a)<day_(d)&&day_(b)>day_(c)}
function validWindow_(a,b){let t=day_(new Date()),last=new Date(t.getFullYear(),t.getMonth()+APP.MONTHS_AHEAD+1,0);return day_(a)>=t&&day_(b)<=last&&day_(a)<day_(b)}
function active_(){return rows_('Bookings').filter(x=>['待付款','待核帳','已成立','取消審核中'].includes(x['狀態']))}
function blocked_(area,pitch,a,b){return rows_('Blocks').some(x=>String(x['啟用']).toUpperCase()!=='FALSE'&&(!x['區域']||x['區域']===area)&&(!x['營位']||x['營位']==='全部'||x['營位']===pitch)&&overlap_(a,b,x['開始日'],x['結束日']))}
function availability(a,b){a=day_(a);b=day_(b);if(!validWindow_(a,b))return{ok:false,message:'目前僅開放今天起至未來三個月內日期；每月1日延伸開放新月份。'};let bs=active_(),out={};Object.keys(APP.AREAS).forEach(area=>{let c=APP.AREAS[area];out[area]=c.ids.map(id=>({id,available:!bs.some(x=>x['區域']===area&&x['營位']===id&&overlap_(a,b,x['入住日'],x['退營日']))&&!blocked_(area,id,a,b),pitches:c.pitches,package:c.type==='package'}))});return{ok:true,areas:out}}
function createBooking(d,internal){let lock=LockService.getScriptLock();lock.waitLock(20000);try{if(!internal&&String(setting_('訂位開放','TRUE')).toUpperCase()==='FALSE')throw Error('目前暫停線上訂位');let a=day_(d.checkin),b=day_(d.checkout),n=nights_(a,b);if(n<1||!validWindow_(a,b))throw Error('日期不正確或不在開放期間');if(!internal){['name','phone','email'].forEach(k=>{if(!String(d[k]||'').trim())throw Error('姓名、電話及Email均為必填')});if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(d.email))throw Error('Email格式錯誤')}let c=APP.AREAS[d.area];if(!c)throw Error('區域錯誤');let pitch=c.type==='package'?c.ids[0]:String(d.pitch||'');if(c.type==='individual'&&!c.ids.includes(pitch))throw Error('請選擇有效帳位');let av=availability(a,b);if(!av.ok||!av.areas[d.area].some(x=>x.id===pitch&&x.available))throw Error('營位已被預訂或封閉');let tents=c.type==='package'?c.pitches:1,rush=d.nightRush===true||String(d.nightRush)==='true',base=tents*n*APP.RATE,extra=rush?tents*APP.NIGHT:0,total=base+extra,now=new Date(),due=new Date(now.getTime()+72*3600000),id='C'+Utilities.formatDate(now,APP.TZ,'yyMMddHHmmss')+Math.floor(100+Math.random()*900),bind=String(Math.floor(100000+Math.random()*900000));add_('Bookings',{'訂單編號':id,'建立時間':now,'狀態':internal?'已成立':'待付款','付款狀態':internal?'現場收款':'未付款','姓名':d.name||'現場訂位','電話':d.phone||'現場登記','Email':d.email||'','LINE綁定碼':bind,'入住日':a,'退營日':b,'區域':d.area,'營位':pitch,'帳數':tents,'夜衝':rush?'是':'否','夜數':n,'基本費用':base,'夜衝費用':extra,'總金額':total,'付款期限':internal?'':due,'退款狀態':'未處理','訂單來源':internal?'現場':'線上','核帳時間':internal?now:'','最後更新':now});log_(internal?'admin':'旅客',internal?'補登現場訂位':'建立訂單',id,'NT$'+total);let booking=rows_('Bookings').find(x=>x['訂單編號']===id);if(!internal){sendCustomer_(booking,'收到訂位申請','請於72小時內全額匯款並回填帳號末五碼，營主核帳後訂位才成立。金額NT$'+total+'；期限'+due+'。LINE綁定：綁定 '+id+' '+bind);notifyAdmin_('新訂位申請',booking)}return{ok:true,id,total,due:internal?'':Utilities.formatDate(due,APP.TZ,'yyyy/MM/dd HH:mm'),bank:APP.BANK,bindCode:bind}}finally{lock.releaseLock()}}
function submitRemittance(d){let b=rows_('Bookings').find(x=>x['訂單編號']===String(d.id||'').trim());if(!b||!['待付款','待核帳'].includes(b['狀態']))throw Error('訂單不存在或不可回填');if(!/^\d{5}$/.test(String(d.last5||'')))throw Error('匯款末五碼必須為5位數字');let now=new Date();patch_('Bookings','訂單編號',d.id,{'匯款末五碼':d.last5,'匯款截圖網址':d.image||'','付款回填時間':now,'狀態':'待核帳','付款狀態':'已回填待核帳','最後更新':now});log_('旅客','回填匯款資料',d.id,d.last5);notifyAdmin_('旅客已回填匯款資料',b);sendCustomer_(b,'已收到匯款資料','已收到匯款末五碼，訂單待營主核帳。');return{ok:true,message:'匯款資料已送出，請等待營主核帳。'}}
function expireHolds(){let now=new Date();rows_('Bookings').filter(b=>b['狀態']==='待付款'&&b['付款期限']&&new Date(b['付款期限'])<now).forEach(b=>{patch_('Bookings','訂單編號',b['訂單編號'],{'狀態':'逾期取消','付款狀態':'逾期未付款','最後更新':now});log_('system','72小時逾期取消',b['訂單編號'],'釋出營位');sendCustomer_(b,'訂單逾期取消','付款期限已過且未回填匯款資料，訂單已取消並釋出營位');notifyAdmin_('訂單逾期取消',b)})}

function requestCancellation(id,reason){let b=rows_('Bookings').find(x=>x['訂單編號']===String(id||'').trim());if(!b||!['待付款','待核帳','已成立'].includes(b['狀態']))throw Error('此訂單目前無法申請取消');patch_('Bookings','訂單編號',id,{'狀態':'取消審核中','取消申請時間':new Date(),'取消原因':reason||'旅客申請取消','最後更新':new Date()});log_('旅客','申請取消',id,reason||'');notifyAdmin_('收到取消申請',b);return{ok:true,message:'取消申請已送出，退款金額待營主審核'}}
