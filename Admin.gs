function adminLogin(pin){let saved=PropertiesService.getScriptProperties().getProperty('ADMIN_PIN');if(!saved)throw Error('請先設定ADMIN_PIN');if(String(pin)!==saved)throw Error('管理密碼錯誤');let t=Utilities.getUuid()+Utilities.getUuid();CacheService.getScriptCache().put('admin_'+t,'1',21600);return{token:t}}
function auth_(t){if(!t||CacheService.getScriptCache().get('admin_'+t)!=='1')throw Error('登入逾時，請重新登入')}
function serialRows_(items){return items.map(o=>Object.fromEntries(Object.entries(o).map(([k,v])=>[k,v instanceof Date?Utilities.formatDate(v,APP.TZ,'yyyy-MM-dd HH:mm:ss'):v])))}
function adminList(t){auth_(t);return{bookings:serialRows_(rows_('Bookings').sort((a,b)=>new Date(b['建立時間'])-new Date(a['建立時間']))),blocks:serialRows_(rows_('Blocks')),photos:serialRows_(rows_('Photos'))}}
function adminConfirmPayment(t,id){auth_(t);let b=rows_('Bookings').find(x=>x['訂單編號']===id);if(!b||!['待核帳','待付款'].includes(b['狀態']))throw Error('訂單狀態不允許核帳');let now=new Date();patch_('Bookings','訂單編號',id,{'狀態':'已成立','付款狀態':'已收款','核帳時間':now,'最後更新':now});log_('admin','核帳成立',id,'');sendCustomer_(b,'訂位成立','您的訂位已完成核帳並正式成立');return{ok:true}}
function adminCancelAndRefund(t,id,amount,reason){auth_(t);let b=rows_('Bookings').find(x=>x['訂單編號']===id);if(!b)throw Error('找不到訂單');amount=Math.max(0,Math.min(Number(amount)||0,Number(b['總金額'])||0));patch_('Bookings','訂單編號',id,{'狀態':'已取消','退款金額':amount,'退款狀態':amount?'待退款':'不退款','管理備註':reason||'','最後更新':new Date()});log_('admin','取消退款審核',id,'退款'+amount);sendCustomer_(b,'取消審核結果','訂單已取消，核定退款NT$'+amount+'。退款完成後請以營主通知為準');return{ok:true}}
function adminMarkRefundDone(t,id){auth_(t);patch_('Bookings','訂單編號',id,{'退款狀態':'已退款','退款完成時間':new Date(),'最後更新':new Date()});log_('admin','標記退款完成',id,'');let b=rows_('Bookings').find(x=>x['訂單編號']===id);if(b)sendCustomer_(b,'退款完成','營主已將此訂單標記為退款完成');return{ok:true}}
function adminBlock(t,d){auth_(t);if(!d.start||!d.end||day_(d.end)<=day_(d.start))throw Error('封閉日期錯誤，結束日須晚於開始日');let id='B'+Date.now();add_('Blocks',{'封閉編號':id,'建立時間':new Date(),'開始日':day_(d.start),'結束日':day_(d.end),'區域':d.area||'','營位':d.pitch||'','原因':d.reason||'營主封閉','啟用':'TRUE'});log_('admin','封閉營位','',JSON.stringify(d));return{id}}
function adminUnblock(t,id){auth_(t);patch_('Blocks','封閉編號',id,{'啟用':'FALSE'});return{ok:true}}function adminSetBookingOpen(t,v){auth_(t);setSetting_('訂位開放',v?'TRUE':'FALSE');return{ok:true}}
function adminAddWalkin(t,d){auth_(t);return createBooking(d,true)}
function monthlyRevenue(t,y,m){auth_(t);let a=new Date(+y,+m-1,1),b=new Date(+y,+m,1),all=rows_('Bookings'),paid=all.filter(x=>x['核帳時間']&&new Date(x['核帳時間'])>=a&&new Date(x['核帳時間'])<b&&['已收款','現場收款'].includes(x['付款狀態'])),refunds=all.filter(x=>x['退款完成時間']&&new Date(x['退款完成時間'])>=a&&new Date(x['退款完成時間'])<b),received=paid.reduce((s,x)=>s+(+x['總金額']||0),0),refunded=refunds.reduce((s,x)=>s+(+x['退款金額']||0),0),byArea={};paid.forEach(x=>byArea[x['區域']]=(byArea[x['區域']]||0)+(+x['總金額']||0));return{orders:all.filter(x=>x['建立時間']&&new Date(x['建立時間'])>=a&&new Date(x['建立時間'])<b).length,paid:received,refunds:refunded,net:received-refunded,byArea}}
function adminAddPhoto(t,d){auth_(t);let id='P'+Date.now();add_('Photos',{'照片編號':id,'建立時間':new Date(),'分類':d.category||'營位','標題':d.title||'','說明':d.description||'','圖片URL':d.url||'','封面':d.cover?'TRUE':'FALSE','排序':Number(d.order)||0,'啟用':'TRUE'});return{id}}
