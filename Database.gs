function setup(){const p=PropertiesService.getScriptProperties();let id=p.getProperty('SPREADSHEET_ID'),ss=id?SpreadsheetApp.openById(id):SpreadsheetApp.create('露營區訂位平台資料庫');p.setProperty('SPREADSHEET_ID',ss.getId());Object.keys(HEADERS).forEach(n=>{let s=ss.getSheetByName(n)||ss.insertSheet(n);if(!s.getLastRow()){s.getRange(1,1,1,HEADERS[n].length).setValues([HEADERS[n]]);s.setFrozenRows(1);s.getRange(1,1,1,HEADERS[n].length).setFontWeight('bold').setBackground('#dce8df')}});let s=ss.getSheetByName('Settings');if(s.getLastRow()<2)s.getRange(2,1,5,2).setValues([['訂位開放','TRUE'],['營區名稱','請填入營區名稱'],['網站公告','歡迎預約'],['管理員通知Email',Session.getEffectiveUser().getEmail()||''],['營區聯絡電話',APP.CONTACT.phone]]);installTriggers_();Logger.log('試算表網址：'+ss.getUrl());return{spreadsheetId:ss.getId(),url:ss.getUrl()}}
function db_(){let id=PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID');if(!id)throw Error('請先執行setup()');return SpreadsheetApp.openById(id)}function sh_(n){return db_().getSheetByName(n)}
function rows_(n){let v=sh_(n).getDataRange().getValues();if(v.length<2)return[];return v.slice(1).filter(r=>r.some(x=>x!=='')).map(r=>Object.fromEntries(v[0].map((h,i)=>[h,r[i]])))}
function add_(n,o){sh_(n).appendRow(HEADERS[n].map(h=>o[h]===undefined?'':o[h]))}
function patch_(n,key,id,obj){let s=sh_(n),v=s.getDataRange().getValues(),c=v[0].indexOf(key);for(let r=1;r<v.length;r++)if(String(v[r][c])===String(id)){Object.keys(obj).forEach(k=>{let x=v[0].indexOf(k);if(x>=0)s.getRange(r+1,x+1).setValue(obj[k])});return true}return false}
function setting_(k,d){let x=rows_('Settings').find(r=>r['設定項目']===k);return x?x['設定值']:d}function setSetting_(k,v){let s=sh_('Settings'),a=s.getDataRange().getValues();for(let i=1;i<a.length;i++)if(a[i][0]===k){s.getRange(i+1,2).setValue(v);return}s.appendRow([k,v])}
function log_(who,what,id,detail){add_('Logs',{'時間':new Date(),'操作者':who||'system','事件':what,'訂單編號':id||'','內容':detail||''})}
function installTriggers_(){ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='expireHolds').forEach(t=>ScriptApp.deleteTrigger(t));ScriptApp.newTrigger('expireHolds').timeBased().everyHours(1).create()}
